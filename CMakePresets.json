    "buildPresets": [
        {
            "name": "release",
            "displayName": "Release",
            "configurePreset": "vs2019",
            "configuration": "Release"
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "configurePreset": "vs2019",
            "configuration": "Debug"
        }
    ]
}
